datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}


model User {
  id        Int      @id @default(autoincrement())

  nickname  String   @unique

  password  String

  server    String

  role      String   @default("USER")

  createdAt DateTime @default(now())
}