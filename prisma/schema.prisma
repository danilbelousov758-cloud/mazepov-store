generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



model User {

  id Int @id @default(autoincrement())

  nickname String @unique

  password String

  server String

  role String

  avatar String

  createdAt DateTime @default(now())

}




model Mod {

  id Int @id @default(autoincrement())


  title String


  category String


  image String?


  dff String?


  txd String?


  dffPath String?


  txdPath String?


  views Int @default(0)


  createdAt DateTime @default(now())


}