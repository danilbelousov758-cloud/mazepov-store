datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}


model User {

  id        Int      @id @default(autoincrement())

  nickname  String   @unique

  password  String

  server    String

  role      String   @default("USER")

  avatar    String   @default("/images/avatar.png")

  createdAt DateTime @default(now())

}



model Mod {

  id Int @id @default(autoincrement())

  title String

  category String

  description String?

  image String?

  dff String?

  txd String?

  createdAt DateTime @default(now())

}