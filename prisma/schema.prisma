generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Mod {

  id Int @id @default(autoincrement())

  title String

  category String

  image String?

  dff String?

  txd String?

  dffPath String?

  txdPath String?

  createdAt DateTime @default(now())

}