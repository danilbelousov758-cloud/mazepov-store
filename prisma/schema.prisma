generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id Int @id @default(autoincrement())

  nickname String?

  password String

  server String?

  role String @default("USER")

  avatar String?

  email String? @unique

  username String? @unique

  createdAt DateTime @default(now())

  tickets SupportTicket[]

  replies SupportReply[]
}

model Mod {
  id Int @id @default(autoincrement())

  title String

  category String

  image String?

  dff String?

  txd String?

  dffPath String?

  txdPath String?

  views Int @default(0)

  createdAt DateTime @default(now())
}

model SupportTicket {
  id Int @id @default(autoincrement())

  userId Int

  subject String

  message String

  status String @default("OPEN")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  replies SupportReply[]
}

model SupportReply {
  id Int @id @default(autoincrement())

  ticketId Int

  userId Int

  message String

  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id])

  user User @relation(fields: [userId], references: [id])
}
